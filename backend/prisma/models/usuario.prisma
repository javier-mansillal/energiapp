/// Elegir el proveedor de OAuth utilizado para la autenticación del usuario.
/// Se pueden agregar más proveedores según sea necesario.
/// Actualmente se soportan Google y Microsoft, pero se pueden agregar otros proveedores en el futuro.
enum OauthProvider {
    google
    azure
}

/// Modelo de usuario con información de autenticación y relación con hogares.
model Usuario {
    id             String        @id
    email          String        @unique
    nombre         String?
    oauthProvider OauthProvider
    oauthId       String        @unique
    // Consentimiento para usar los datos del hogar en comparaciones anónimas
    // con otros usuarios de la app (por región). Si está en false, la regla
    // "region-alta" del módulo de recomendaciones no se dispara.
    permiteComparaciones Boolean   @default(true)
    createdAt     DateTime      @default(now())
    updatedAt     DateTime      @updatedAt
    // Relación de usuario con otros modelos.
    hogares        Hogar[]

    @@map("usuarios")
}
